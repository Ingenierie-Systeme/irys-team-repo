<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Launch files to start the robot ROS 2 stack.</description>
  <maintainer email="noe.carrayrou@ensta.fr">noeca</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend>
  <exec_depend>sensor_subscriber</exec_depend>
  <exec_depend>robot_brain</exec_depend>
  <exec_depend>robot_pose</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
